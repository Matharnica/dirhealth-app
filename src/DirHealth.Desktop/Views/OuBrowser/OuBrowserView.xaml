<UserControl x:Class="DirHealth.Desktop.Views.OuBrowser.OuBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:DirHealth.Desktop.Views.Shared">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- Left: OU list -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,20,16,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Organizational Units" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
            <TextBox Grid.Row="1" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Background="{DynamicResource InputBackgroundBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource InputBorderBrush}"
                     Padding="8,6" Margin="0,0,0,8" AutomationProperties.Name="Filter OUs" />
            <TextBlock Grid.Row="2" Text="Loading…" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            <Grid Grid.Row="3">
                <shared:DataTable DataContext="{Binding Table}" />
                <!-- Shared empty / error state (S12-1) -->
                <shared:ListStateOverlay />
            </Grid>
        </Grid>
        </Border>

        <!-- Right: OU detail -->
        <ScrollViewer Grid.Column="1" Margin="24,20,24,20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedOU}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding SelectedOU.Name}" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding SelectedOU.Description}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="13" Margin="0,0,0,16" TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True" Height="2" Margin="0,0,0,8"
                             Background="Transparent" Foreground="{StaticResource AccentBrush}"
                             BorderThickness="0"
                             Visibility="{Binding IsLoadingCounts, Converter={StaticResource BoolToVisibility}}" />
                <UniformGrid Columns="3" Margin="0,0,0,16">
                    <Border Style="{StaticResource Card}" Margin="0,4,8,8">
                        <StackPanel>
                            <TextBlock Text="USERS" FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SelectedOuUserCount}" FontSize="28"
                                       FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,4,8,8">
                        <StackPanel>
                            <TextBlock Text="COMPUTERS" FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SelectedOuComputerCount}" FontSize="28"
                                       FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,4,0,8">
                        <StackPanel>
                            <TextBlock Text="GROUPS" FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SelectedOuGroupCount}" FontSize="28"
                                       FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <TextBlock Text="DISTINGUISHED NAME" FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding SelectedOU.DistinguishedName, Mode=OneWay}"
                         Style="{StaticResource CopyableText}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="11" FontFamily="Consolas" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Column="1" Text="Select an OU to view details"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedOU}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
