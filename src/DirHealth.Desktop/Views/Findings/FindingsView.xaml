<UserControl x:Class="DirHealth.Desktop.Views.Findings.FindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:DirHealth.Desktop.Views.Shared">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: findings list + filters -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,20,16,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Findings" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="CSV" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportCsvCommand}"
                            Padding="10,4" FontSize="11" Margin="0,0,6,0" />
                    <Button Content="PDF" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportPdfCommand}"
                            Padding="10,4" FontSize="11" />
                </StackPanel>
            </Grid>

            <TextBox Grid.Row="1" Style="{StaticResource DarkTextBox}"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Filter findings…" Margin="0,0,0,8" />

            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="SEVERITY" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Width="110"
                          ItemsSource="{Binding SeverityOptions}"
                          SelectedItem="{Binding SeverityFilter}" />
            </Grid>

            <StackPanel Grid.Row="3">
                <CheckBox Content="Show acknowledged"
                          IsChecked="{Binding ShowAcknowledged}"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Margin="0,0,0,4" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>

            <ListBox Grid.Row="4"
                     ItemsSource="{Binding FilteredFindings}"
                     SelectedItem="{Binding SelectedFinding}"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding Description}">
                            <!-- Severity stripe -->
                            <Border Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#64748B" />
                                        <Style.Triggers>
                                            <!-- Accent colours from SeverityPalette, same as the PDF (A9) -->
                                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                <Setter Property="Background" Value="{StaticResource CriticalSeverityBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="High">
                                                <Setter Property="Background" Value="{StaticResource HighSeverityBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                                <Setter Property="Background" Value="{StaticResource MediumSeverityBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <!-- Content -->
                            <Border Padding="11,10,8,10" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <!-- Colour-coded severity badge -->
                                        <Border CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#334155" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                            <Setter Property="Background" Value="#7F1D1D" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="High">
                                                            <Setter Property="Background" Value="#7F1D1D" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                                            <Setter Property="Background" Value="#78350F" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Severity, Mode=OneWay}" FontSize="10"
                                                       FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                        <TextBlock FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="{Binding Count, Mode=OneWay}" />
                                            <Run Text=" affected" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1E2235" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#161925" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
        </Border>

        <!-- Right: finding detail -->
        <Border Grid.Column="1" Margin="24,20,24,20" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Select a finding to view details"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedFinding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Finding card (S16-2): fixed grid — title, rule, what/why/how, fix block, references, objects -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedFinding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="{Binding SelectedFinding.Title, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock FontSize="11" Margin="0,4,0,10" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="{Binding SelectedFinding.RuleId, Mode=OneWay}" FontFamily="Consolas" />
                        <Run Text="  ·  " /><Run Text="{Binding SelectedFinding.Severity, Mode=OneWay}" />
                        <Run Text="  ·  weight " /><Run Text="{Binding SelectedFinding.Weight, Mode=OneWay}" /><Run Text="/10" />
                    </TextBlock>
                    <TextBlock Text="{Binding SelectedFinding.Description, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

                    <TextBlock Text="WHAT IS IT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding SelectedRule.What, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,10" />
                    <TextBlock Text="WHY IT MATTERS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding SelectedRule.Why, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,10" />
                    <TextBlock Text="HOW TO FIX" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding SelectedRule.HowToFix, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,12" />

                    <!-- Fix block (S16-3): shown and copied, never run by DirHealth (read-only) -->
                    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12"
                            Visibility="{Binding SelectedRule, Converter={StaticResource NullToVisibility}}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="FIX (POWERSHELL)" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource SecondaryButton}"
                                        Padding="10,2" FontSize="11" Command="{Binding CopyFixCommand}"
                                        AutomationProperties.Name="Copy fix command" />
                            </DockPanel>
                            <TextBox Text="{Binding SelectedRule.Fix, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" MaxHeight="160"
                                     VerticalScrollBarVisibility="Auto" Margin="0,6,0,6"
                                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" Padding="6" />
                            <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="#FCD34D">
                                <Run Text="Operational risk: " FontWeight="SemiBold" /><Run Text="{Binding SelectedRule.FixRisk, Mode=OneWay}" />
                            </TextBlock>
                            <DockPanel LastChildFill="False" Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="UNDO" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource SecondaryButton}"
                                        Padding="10,2" FontSize="11" Command="{Binding CopyRevertCommand}"
                                        AutomationProperties.Name="Copy undo command" />
                            </DockPanel>
                            <TextBox Text="{Binding SelectedRule.Revert, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" MaxHeight="110"
                                     VerticalScrollBarVisibility="Auto" Margin="0,6,0,6"
                                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" Padding="6" />
                            <TextBlock Text="DirHealth only reads Active Directory. These commands are for you to review and run; they start with -WhatIf and save a backup file first."
                                       FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- References -->
                    <TextBlock Text="REFERENCES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding SelectedFinding.References, Mode=OneWay}" Margin="0,2,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label, Mode=OneWay}" HorizontalAlignment="Left" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0" Padding="0,2" FontSize="12"
                                        Foreground="{StaticResource AccentHoverBrush}" ToolTip="{Binding Url, Mode=OneWay}"
                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Url}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Affected objects: table with export; double-click opens the object (S15-2) -->
                    <TextBlock Text="AFFECTED OBJECTS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <shared:DataTable Height="300" Margin="0,4,0,0" DataContext="{Binding ObjectsTable}" />
                    <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>

                <!-- Acknowledge section -->
                <StackPanel Margin="0,16,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedFinding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="ACKNOWLEDGE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                    <TextBox Style="{StaticResource DarkTextBox}"
                             Text="{Binding AcknowledgeNote, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Optional note (e.g. 'all service accounts, reviewed')"
                             Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="✓ Acknowledge" Padding="12,6" FontSize="12"
                                Command="{Binding AcknowledgeCommand}"
                                Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFindingIsAcknowledged}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="↩ Unacknowledge" Padding="12,6" FontSize="12"
                                Command="{Binding UnacknowledgeCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFindingIsAcknowledged}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
