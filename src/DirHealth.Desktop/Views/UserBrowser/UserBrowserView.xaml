<UserControl x:Class="DirHealth.Desktop.Views.UserBrowser.UserBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:DirHealth.Desktop.Views.Shared"
             xmlns:detail="clr-namespace:DirHealth.Desktop.Views.UserDetail">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- User table (S14-1) -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,20,16,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Users" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <!-- S14-4: ADRecon-style export with opt-in personal columns -->
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                        Content="Export users…" Padding="12,4" FontSize="12" VerticalAlignment="Center"
                        Click="ExportUsers_Click" IsEnabled="{Binding Table.HasAnyRows, Mode=OneWay}"
                        AutomationProperties.Name="Export users with all attributes" />
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource InputBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource InputBorderBrush}"
                         Padding="8,6" Margin="0,0,8,0"
                         AutomationProperties.Name="Filter users" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding UserFilterOptions}"
                          SelectedItem="{Binding UserFilter}"
                          Background="{DynamicResource InputBackgroundBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource InputBorderBrush}">
                    <ComboBox.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"     Color="#1E293B" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F1F5F9" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"  Color="#6366F1" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
                    </ComboBox.Resources>
                </ComboBox>
            </Grid>
            <!-- S15-6: local quick filters (narrow the loaded list, no new query) -->
            <WrapPanel Grid.Row="2" Margin="0,0,0,6">
                <TextBlock Text="Show only:" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,6"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <ToggleButton Style="{StaticResource FilterChip}" Content="Disabled"               IsChecked="{Binding ChipDisabled}" />
                <ToggleButton Style="{StaticResource FilterChip}" Content="Password never expires" IsChecked="{Binding ChipPasswordNeverExpires}" />
                <ToggleButton Style="{StaticResource FilterChip}" Content="Admin (adminCount)"     IsChecked="{Binding ChipAdmin}"
                              ToolTip="adminCount = 1: protected by AdminSDHolder — current or former member of an admin group" />
                <ToggleButton Style="{StaticResource FilterChip}" Content="Inactive &gt; 90 d"     IsChecked="{Binding ChipInactive}"
                              ToolTip="No replicated logon in 90 days (±14 d), or never logged on" />
            </WrapPanel>
            <ProgressBar Grid.Row="3" Height="2" IsIndeterminate="True" Margin="0,0,0,4" VerticalAlignment="Top"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            <Grid Grid.Row="3">
                <shared:DataTable x:Name="UserTable" DataContext="{Binding Table}" />
                <!-- Shared empty / error state (S12-1) -->
                <shared:ListStateOverlay />
            </Grid>
        </Grid>
        </Border>

        <!-- User detail (S15-4: shared view, also used by the search) -->
        <Border Grid.Column="1" Width="480" Margin="24,20,24,20"
                Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVisibility}}">
            <detail:UserDetailView DataContext="{Binding Detail}" />
        </Border>
    </Grid>
</UserControl>
