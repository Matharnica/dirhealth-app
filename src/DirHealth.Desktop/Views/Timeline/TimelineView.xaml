<UserControl x:Class="DirHealth.Desktop.Views.Timeline.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:DirHealth.Desktop.Views.Shared">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left panel -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,20,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Recent Changes" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="0" Text="Created &amp; modified accounts" FontSize="11"
                           VerticalAlignment="Bottom"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />

                <StackPanel Grid.Row="1">
                    <Border Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="CREATED" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding CreatedCount}" FontSize="24" FontWeight="Black"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="MODIFIED" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding ModifiedCount}" FontSize="24" FontWeight="Black"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Period selector -->
                    <TextBlock Text="TIME RANGE" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton Content="7d" GroupName="Period" Margin="0,0,8,0"
                                     IsChecked="{Binding SelectedDays, Converter={StaticResource EqualityConverter}, ConverterParameter=7}" />
                        <RadioButton Content="30d" GroupName="Period" Margin="0,0,8,0"
                                     IsChecked="{Binding SelectedDays, Converter={StaticResource EqualityConverter}, ConverterParameter=30}" />
                        <RadioButton Content="90d" GroupName="Period"
                                     IsChecked="{Binding SelectedDays, Converter={StaticResource EqualityConverter}, ConverterParameter=90}" />
                    </StackPanel>

                    <Button Style="{StaticResource PrimaryButton}"
                            Content="↻  Refresh" Command="{Binding LoadCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                    <ProgressBar IsIndeterminate="True" Height="2"
                                 Background="Transparent" Foreground="{StaticResource AccentBrush}"
                                 BorderThickness="0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right: timeline list -->
        <Grid Grid.Column="1" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Not-loaded placeholder -->
            <TextBlock Grid.RowSpan="2" Text="Click Refresh to load recent changes."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibility}}" />

            <!-- Shared empty / error state (S12-1) -->
            <shared:ListStateOverlay Grid.RowSpan="2" />

            <!-- Shared table (S14-3): sortable, counter, CSV export, copy menu -->
            <shared:DataTable Grid.Row="0" Grid.RowSpan="2" DataContext="{Binding Table}" />
        </Grid>
    </Grid>
</UserControl>
