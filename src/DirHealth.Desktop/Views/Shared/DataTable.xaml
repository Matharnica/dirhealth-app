<UserControl x:Class="DirHealth.Desktop.Views.Shared.DataTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared table (S14-1). DataContext = a TableViewModel. Columns are built in code-behind
         from TableViewModel.Columns, so each view only defines its columns once. Host views
         put a ListStateOverlay (S12-1) on top of this control for loading/empty/error. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding CountLabel, Mode=OneWay}"
                       AutomationProperties.Name="Row count" />
            <Button x:Name="ExportButton" DockPanel.Dock="Right"
                    Style="{StaticResource SecondaryButton}" Padding="10,3" FontSize="11"
                    Content="Export ▾" Click="ExportButton_Click"
                    IsEnabled="{Binding HasAnyRows, Mode=OneWay}"
                    AutomationProperties.Name="Export table">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding ExportFilteredLabel, Mode=OneWay}" Command="{Binding ExportFilteredCommand}" />
                        <MenuItem Header="{Binding ExportAllLabel, Mode=OneWay}"      Command="{Binding ExportAllCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding ExportXlsxFilteredLabel, Mode=OneWay}" Command="{Binding ExportXlsxFilteredCommand}" />
                        <MenuItem Header="{Binding ExportXlsxAllLabel, Mode=OneWay}"      Command="{Binding ExportXlsxAllCommand}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </DockPanel>

        <DataGrid x:Name="TableGrid" Grid.Row="1"
                  Style="{StaticResource DataTableGrid}"
                  ColumnHeaderStyle="{StaticResource DataTableHeader}"
                  RowStyle="{StaticResource DataTableRow}"
                  CellStyle="{StaticResource DataTableCell}"
                  ItemsSource="{Binding Rows, Mode=OneWay}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  MouseDoubleClick="Grid_MouseDoubleClick"
                  PreviewKeyDown="Grid_PreviewKeyDown">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy DN"             Command="{Binding CopyDnCommand}"
                              Visibility="{Binding CanCopyDn, Converter={StaticResource BoolToVisibility}}" />
                    <MenuItem Header="Copy SID"            Command="{Binding CopySidCommand}"
                              Visibility="{Binding CanCopySid, Converter={StaticResource BoolToVisibility}}" />
                    <MenuItem Header="Copy sAMAccountName" Command="{Binding CopySamCommand}"
                              Visibility="{Binding CanCopySam, Converter={StaticResource BoolToVisibility}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <TextBlock Grid.Row="2" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding StatusMessage, Mode=OneWay}"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
    </Grid>
</UserControl>
