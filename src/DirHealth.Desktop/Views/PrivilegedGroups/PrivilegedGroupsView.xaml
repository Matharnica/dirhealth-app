<UserControl x:Class="DirHealth.Desktop.Views.PrivilegedGroups.PrivilegedGroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:DirHealth.Desktop.Views.Shared">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left panel -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,20,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Privileged Groups" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="0" Text="All elevated AD groups" FontSize="11" VerticalAlignment="Bottom"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />

                <StackPanel Grid.Row="1">
                    <Border Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="TOTAL MEMBERS" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding TotalMembers}" FontSize="24" FontWeight="Black"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="EMPTY GROUPS" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding EmptyGroups}" FontSize="24" FontWeight="Black"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}"
                            Content="↻  Refresh" Command="{Binding LoadCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                    <ProgressBar IsIndeterminate="True" Height="2"
                                 Background="Transparent" Foreground="{StaticResource AccentBrush}"
                                 BorderThickness="0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right: group list -->
        <Grid Grid.Column="1" Margin="24,20,24,20">
            <TextBlock Text="Click Refresh to load privileged groups."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Groups}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- One row per membership; empty / not-found groups keep a row with a Status (S14-2) -->
            <shared:DataTable DataContext="{Binding Table}">
                <shared:DataTable.Style>
                    <Style TargetType="UserControl">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.Groups, RelativeSource={RelativeSource AncestorType=Grid}}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </shared:DataTable.Style>
            </shared:DataTable>
        </Grid>
    </Grid>
</UserControl>
