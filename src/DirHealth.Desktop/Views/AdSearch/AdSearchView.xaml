<UserControl x:Class="DirHealth.Desktop.Views.AdSearch.AdSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:DirHealth.Desktop.Views.Shared"
             xmlns:userDetail="clr-namespace:DirHealth.Desktop.Views.UserDetail"
             xmlns:computerDetail="clr-namespace:DirHealth.Desktop.Views.ComputerDetail">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" MinWidth="380" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left panel -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,24,16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="AD Search" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20" />

                <TextBlock Grid.Row="1" Text="SEARCH TYPE" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <ComboBox Grid.Row="2"
                          ItemsSource="{Binding Modes}"
                          SelectedItem="{Binding SelectedMode}"
                          DisplayMemberPath="Label"
                          Margin="0,0,0,8" />

                <!-- LDAP Filter warning — shown only when raw LDAP mode is active -->
                <Border Grid.Row="3"
                        Background="#3D2A00" BorderBrush="#92400E" BorderThickness="1"
                        CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLdapMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="⚠ Unrestricted Access" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FCD34D" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FDE68A"
                                   Text="This filter runs with full Domain Admin read access. Any AD attribute — including credential history — is in scope." />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="4" Text="QUERY" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />

                <StackPanel Grid.Row="5">
                    <TextBox Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}"
                             BorderThickness="1" Padding="8,6"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="Search" Command="{Binding SearchCommand}" />
                    <!-- S15-3 -->
                    <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Tip: prefix user:, group:, computer: or ou: to search one object type by name." />

                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                    <TextBlock Text="Searching…" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Results (S15-1): shared table; double-click / Enter opens the detail on the right (S15-2) -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Results" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />

            <!-- "Showing 500 of more than 500 — narrow your search" -->
            <Border Grid.Row="1" Background="#3D2A00" BorderBrush="#92400E" BorderThickness="1"
                    CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                    Visibility="{Binding LimitHint, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding LimitHint, Mode=OneWay}" FontSize="11" Foreground="#FDE68A" TextWrapping="Wrap" />
            </Border>

            <shared:DataTable Grid.Row="2" DataContext="{Binding Table}" />

            <!-- Empty state after a search returns nothing -->
            <TextBlock Grid.Row="2" Text="No results found." IsHitTestVisible="False"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasSearched}" Value="True" />
                                    <Condition Binding="{Binding Table.TotalCount}" Value="0" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- S13-4: a failed search is an error, never the "No results" state -->
            <TextBlock Grid.Row="2" FontSize="13" Foreground="#FCA5A5" TextWrapping="Wrap" MaxWidth="480"
                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Text="{Binding ErrorMessage, Mode=OneWay, StringFormat='⚠ Search failed: {0}'}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- Detail next to the list (S15-2): list and selection stay; Esc or ✕ closes -->
        <Border Grid.Column="2" Width="480" Margin="0,24,24,24"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="16,0,0,0"
                Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                    <ProgressBar DockPanel.Dock="Left" Width="120" Height="2" IsIndeterminate="True" VerticalAlignment="Center"
                                 Visibility="{Binding IsLoadingDetail, Converter={StaticResource BoolToVisibility}}" />
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource SecondaryButton}"
                            Padding="8,2" FontSize="11" Command="{Binding CloseDetailCommand}"
                            ToolTip="Close (Esc)" AutomationProperties.Name="Close detail" />
                </DockPanel>

                <userDetail:UserDetailView Grid.Row="1" DataContext="{Binding UserDetail}"
                                           Visibility="{Binding DataContext.ShowUserDetail, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=1}, Converter={StaticResource BoolToVisibility}}" />
                <computerDetail:ComputerDetailView Grid.Row="1" DataContext="{Binding ComputerDetail}"
                                           Visibility="{Binding DataContext.ShowComputerDetail, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=1}, Converter={StaticResource BoolToVisibility}}" />

                <!-- Group detail -->
                <Grid Grid.Row="1" Visibility="{Binding ShowGroupDetail, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding GroupDetail.Name, Mode=OneWay}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Text="{Binding GroupDetail.Description, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,10" />
                    <shared:DataTable Grid.Row="2" DataContext="{Binding GroupMembersTable}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
