<UserControl x:Class="DirHealth.Desktop.Views.GpoBrowser.GpoBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:DirHealth.Desktop.Views.Shared">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left panel -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,20,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Group Policy" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="0" Text="GPO hygiene &amp; link status" FontSize="11"
                           VerticalAlignment="Bottom"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />

                <StackPanel Grid.Row="1">
                    <Border Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="TOTAL GPOS" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding GpoCount}" FontSize="24" FontWeight="Black"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="ORPHANED (UNLINKED)" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding OrphanedCount}" FontSize="24" FontWeight="Black"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="DISABLED" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding DisabledCount}" FontSize="24" FontWeight="Black"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}"
                            Content="↻  Refresh" Command="{Binding LoadCommand}"
                            AutomationProperties.Name="Refresh group policy objects"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                    <ProgressBar IsIndeterminate="True" Height="2"
                                 Background="Transparent" Foreground="{StaticResource AccentBrush}"
                                 BorderThickness="0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right: GPO list -->
        <Grid Grid.Column="1" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Not-loaded placeholder -->
            <TextBlock Grid.RowSpan="2" Text="Click Refresh to load group policy objects."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibility}}" />

            <!-- Error state -->
            <TextBlock Grid.RowSpan="2" FontSize="13" TextWrapping="Wrap" MaxWidth="420"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#FCA5A5"
                       Text="{Binding ErrorMessage, StringFormat='⚠ Could not load GPOs: {0}'}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

            <!-- Empty state (loaded, zero rows) -->
            <TextBlock Grid.RowSpan="2" Text="No group policy objects found. ✓"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}" />

            <!-- Shared table (S14-3): sortable, counter, CSV export, copy menu -->
            <shared:DataTable Grid.Row="0" Grid.RowSpan="2" DataContext="{Binding Table}" />
        </Grid>
    </Grid>
</UserControl>
