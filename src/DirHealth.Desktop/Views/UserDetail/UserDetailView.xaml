<UserControl x:Class="DirHealth.Desktop.Views.UserDetail.UserDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:DirHealth.Desktop.Views.Shared">
    <!-- User detail (S15-4). DataContext = UserDetailViewModel. Used by the user browser and the search. -->
    <UserControl.Resources>
        <!-- Empty sections stay visible but greyed out -->
        <Style x:Key="DetailSection" TargetType="Expander">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding User.DisplayName, Mode=OneWay}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <!-- Honest wording: member of a Tier 0 group, not "exposed" -->
                    <Border Background="#7F1D1D" CornerRadius="4" Padding="7,2" Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsTier0, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Member of a Tier 0 group (Domain/Enterprise/Schema Admins, Administrators, operators, Key Admins)">
                        <TextBlock Text="Tier 0 member" FontSize="11" FontWeight="SemiBold" Foreground="#FCA5A5" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                        Content="Export dossier…" Padding="12,4" FontSize="12"
                        Command="{Binding ExportPdfCommand}"
                        ToolTip="PDF with attributes, groups with path and affected findings, plus CSVs and .meta.txt (SHA-256)"
                        AutomationProperties.Name="Export user dossier" />
            </Grid>
            <TextBlock Text="{Binding User.SamAccountName, Mode=OneWay}" FontSize="12" FontFamily="Consolas"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
            <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
            <ProgressBar Height="2" IsIndeterminate="True" Margin="0,0,0,8"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <!-- Name / value list -->
            <ItemsControl ItemsSource="{Binding Attributes, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label, Mode=OneWay}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}"
                                     FontSize="12" TextWrapping="Wrap">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource CopyableText}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <!-- Risky values (no pre-auth, unconstrained delegation …) stand out -->
                                            <DataTrigger Binding="{Binding Warn}" Value="True">
                                                <Setter Property="Foreground" Value="#FCA5A5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Member Of (n) — direct / nested / primary from S13-2, with path -->
            <Expander Style="{StaticResource DetailSection}" IsExpanded="True"
                      IsEnabled="{Binding HasGroups, Mode=OneWay}">
                <Expander.Header>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                        <Run Text="Member Of (" /><Run Text="{Binding GroupCount, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                </Expander.Header>
                <!-- Bounded height so the table virtualizes inside the scroll viewer -->
                <shared:DataTable Height="260" Margin="0,6,0,0" DataContext="{Binding GroupsTable}" />
            </Expander>
            <!-- A failed lookup must be visible even though the section is disabled when empty -->
            <TextBlock Text="{Binding GroupsError, Mode=OneWay}" TextWrapping="Wrap"
                       Foreground="#FCA5A5" FontSize="12" Margin="0,4,0,0"
                       Visibility="{Binding GroupsError, Converter={StaticResource StringToVisibility}}" />

            <!-- Affected by Findings (n) -->
            <Expander Style="{StaticResource DetailSection}" IsExpanded="True"
                      IsEnabled="{Binding HasFindings, Mode=OneWay}">
                <Expander.Header>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                        <Run Text="Affected by Findings (" /><Run Text="{Binding FindingCount, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding AffectedFindings, Mode=OneWay}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                <StackPanel>
                                    <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}">
                                        <Run Text="{Binding Severity, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Title, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Remediation, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
