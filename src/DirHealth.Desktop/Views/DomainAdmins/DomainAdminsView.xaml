<UserControl x:Class="DirHealth.Desktop.Views.DomainAdmins.DomainAdminsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:DirHealth.Desktop.Views.Shared">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left panel -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,20,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding Group.Name, FallbackValue='Domain Admins', TargetNullValue='Domain Admins'}" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20" />

                <StackPanel Grid.Row="1">
                    <Border Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="MEMBERS" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBlock FontSize="28" FontWeight="Black">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="—" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Group}" Value="{x:Null}">
                                                <Setter Property="Text" Value="—" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.Text>
                                    <Binding Path="Group.Members.Count" Mode="OneWay" FallbackValue="—" />
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="in Domain Admins group" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}"
                            Content="↻  Refresh" Command="{Binding LoadCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                    <ProgressBar IsIndeterminate="True" Height="2"
                                 Background="Transparent" Foreground="{StaticResource AccentBrush}"
                                 BorderThickness="0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right: members list -->
        <Grid Grid.Column="1" Margin="24,20,24,20">
            <!-- Empty / not-loaded state — only when not loading AND no data -->
            <TextBlock Text="Click Refresh to load Domain Admins."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Group}" Value="{x:Null}" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Grid, not StackPanel/ScrollViewer: the table needs a bounded height to virtualize -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Group}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                    <!-- Warning banner if many admins -->
                    <Border Grid.Row="0" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                            Background="#7F1D1D"
                            Visibility="{Binding Group.Members.Count, Converter={StaticResource NonZeroToVisibility}, Mode=OneWay}">
                        <TextBlock FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap">
                            <Run Text="⚠  " FontWeight="Bold"/>
                            <Run Text="{Binding Group.Members.Count, Mode=OneWay}"/>
                            <Run Text=" member(s) have domain admin privileges. Review regularly and keep this list minimal."/>
                        </TextBlock>
                    </Border>

                    <!-- Member table (S14-2) -->
                    <shared:DataTable Grid.Row="1" DataContext="{Binding Table}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
