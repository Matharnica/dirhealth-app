<UserControl x:Class="DirHealth.Desktop.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left panel -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="20,24,20,20">
                <!-- G2: score details scroll; "Last scan", status and the buttons stay fixed below -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0" Text="Dashboard" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24" />

                <!-- Score + Stats -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="0,0,4,0">
                    <TextBlock Text="HEALTH SCORE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ScoreDisplay, Mode=OneWay}" FontSize="52" FontWeight="Black"
                               Foreground="{Binding ComplianceScore, Converter={StaticResource ScoreColor}}"
                               LineHeight="52"
                               ToolTip="Health score 0–100, higher is better. Each finding deducts 2.5 × its rule weight × how widespread it is. ≥80 = healthy, ≥60 = review recommended, &lt;60 = critical issues found." />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="/ 100" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ScoreTrendText}" FontSize="11" Margin="8,0,0,0"
                                   Visibility="{Binding ScoreTrendText, Converter={StaticResource StringToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScoreTrendIsPositive}" Value="True">
                                            <Setter Property="Foreground" Value="#22C55E" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ScoreTrendIsNegative}" Value="True">
                                            <Setter Property="Foreground" Value="#EF4444" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- ADR 0002: coverage and the upper bound / n/a note belong to the score -->
                    <TextBlock Text="{Binding ScoreCoverageText, Mode=OneWay}" FontSize="11" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding ScoreCoverageText, Converter={StaticResource StringToVisibility}}" />
                    <TextBlock Text="{Binding ScoreNote, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="#FCD34D"
                               Visibility="{Binding ScoreNote, Converter={StaticResource StringToVisibility}}" />

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,12" />

                    <!-- G3: open findings per severity — the most serious risks, not hygiene topics.
                         Counts findings with open objects (not fully excepted), same unit as the list. -->
                    <TextBlock Text="OPEN FINDINGS" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,6"
                            HorizontalContentAlignment="Stretch" Padding="10,8"
                            Command="{Binding OpenCategoryCommand}" CommandParameter=""
                            AutomationProperties.Name="Critical findings"
                            ToolTip="Open findings rated Critical — fix these first. Click to open Findings, most severe first.">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Height="16" Margin="0,0,8,0" CornerRadius="1"
                                    Background="{StaticResource CriticalSeverityBrush}" />
                            <TextBlock Grid.Column="1" Text="Critical" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding CriticalCount, Mode=OneWay}"
                                       FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,6"
                            HorizontalContentAlignment="Stretch" Padding="10,8"
                            Command="{Binding OpenCategoryCommand}" CommandParameter=""
                            AutomationProperties.Name="High findings"
                            ToolTip="Open findings rated High. Click to open Findings, most severe first.">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Height="16" Margin="0,0,8,0" CornerRadius="1"
                                    Background="{StaticResource HighSeverityBrush}" />
                            <TextBlock Grid.Column="1" Text="High" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding HighCount, Mode=OneWay}"
                                       FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,0"
                            HorizontalContentAlignment="Stretch" Padding="10,8"
                            Command="{Binding OpenCategoryCommand}" CommandParameter=""
                            AutomationProperties.Name="Medium findings"
                            ToolTip="Open findings rated Medium. Click to open Findings, most severe first.">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Height="16" Margin="0,0,8,0" CornerRadius="1"
                                    Background="{StaticResource MediumSeverityBrush}" />
                            <TextBlock Grid.Column="1" Text="Medium" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding MediumCount, Mode=OneWay}"
                                       FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>
                    </Button>

                    <!-- Where the points go (S17-4), capped at five rows (G2) -->
                    <TextBlock Text="POINTS IF FIXED" FontSize="10" FontWeight="SemiBold" Margin="0,12,0,4"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding ScoreBreakdown.Count, Converter={StaticResource NonZeroToVisibility}, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{Binding ScoreBreakdownTop, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,1"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Category, Mode=OneWay, Converter={StaticResource ReadableCategory}}">
                                    <Run Text="+" Foreground="#4ADE80" /><Run Text="{Binding PointsIfFixed, Mode=OneWay}" Foreground="#4ADE80" FontWeight="SemiBold" />
                                    <Run Text="  " /><Run Text="{Binding Category, Mode=OneWay, Converter={StaticResource ReadableCategory}}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ScoreBreakdownMore, Mode=OneWay}" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding ScoreBreakdownMore, Converter={StaticResource StringToVisibility}}" />

                    <!-- S16-4: status of every check — a failed check is never shown as passed -->
                    <TextBlock Text="{Binding CheckSummary, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               ToolTip="Passed = checked, nothing found · Found = issues found · Failed = the check could not run · Not applicable = nothing to check in this domain"
                               Visibility="{Binding CheckSummary, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
                </ScrollViewer>

                <!-- Last scan + status: fixed, always visible (G2) -->
                <StackPanel Grid.Row="2" Margin="0,12,0,12">
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />
                    <TextBlock Text="LAST SCAN" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding LastScanTime, Converter={StaticResource RelativeScanTime}}"
                               ToolTip="{Binding LastScanTime}"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="64"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" />
                </StackPanel>

                <!-- Buttons at bottom -->
                <StackPanel Grid.Row="3">
                    <ProgressBar IsIndeterminate="True" Height="2" Margin="0,0,0,10"
                                 Background="Transparent" Foreground="{StaticResource AccentBrush}"
                                 BorderThickness="0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="▶  Run Scan"
                            Command="{Binding RunScanCommand}" Margin="0,0,0,8"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Full Report PDF"
                            Command="{Binding ExportFullReportCommand}"
                            FontSize="12" />
                    <!-- S22: exports for work and audit — enabled only after a live scan -->
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Work List (CSV / Excel)"
                            ToolTip="One row per rule and object: rule id, severity, weight, object, DN, SID, exception, how to fix"
                            Command="{Binding ExportWorklistCommand}"
                            FontSize="12" Margin="0,8,0,0" />
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Workbook Excel"
                            ToolTip="Summary sheet, one sheet per finding, info sheet"
                            Command="{Binding ExportWorkbookCommand}"
                            FontSize="12" Margin="0,8,0,0" />
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Scan JSON"
                            ToolTip="The whole scan as versioned JSON for scripts and SIEM"
                            Command="{Binding ExportScanJsonCommand}"
                            FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right panel -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
            <!-- S19: one-time notice after a score-model change -->
            <Border Background="#3D2A00" BorderBrush="#92400E" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                    Visibility="{Binding ScoreModelNotice, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding ScoreModelNotice, Mode=OneWay}" FontSize="12" Foreground="#FDE68A" TextWrapping="Wrap" />
            </Border>
            <!-- S16-4: failed checks are visible, with their reason -->
            <Border Background="#7F1D1D" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                    Visibility="{Binding HasFailedChecks, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding FailedChecksNote, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#FCA5A5" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding FailedChecks, Mode=OneWay}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="11" Foreground="#FECACA" TextWrapping="Wrap" Margin="0,1">
                                    <Run Text="{Binding RuleId, Mode=OneWay}" FontFamily="Consolas" /><Run Text="  " /><Run Text="{Binding Category, Mode=OneWay, Converter={StaticResource ReadableCategory}}" /><Run Text=": " /><Run Text="{Binding Reason, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Findings" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                        Content="View all →" Padding="12,4" FontSize="12"
                        Command="{Binding OpenCategoryCommand}"
                        CommandParameter=""
                        Visibility="{Binding FindingsCount, Converter={StaticResource NonZeroToVisibility}}" />
            </Grid>
            </StackPanel>

            <!-- Findings list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- G3: most severe first (sorted in the ViewModel) -->
                    <ItemsControl ItemsSource="{Binding SortedFindings, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource FindingRow}"
                                        Command="{Binding DataContext.OpenFindingCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="12,0,0,0">
                                            <!-- Severity badge: shared style, colours from SeverityPalette (Q1, A9) -->
                                            <Border Style="{StaticResource SeverityBadge}" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Severity, Mode=OneWay}"
                                                           Style="{StaticResource SeverityBadgeText}" />
                                            </Border>
                                            <TextBlock Text="{Binding Count}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock Text="affected  →" FontSize="12"
                                                       Foreground="{StaticResource AccentHoverBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Welcome card — first run only -->
                    <Border Margin="0,8,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFirstRun}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="👋 Welcome to DirHealth" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
                            <!-- Q7: the real flow — credentials are asked at login and the scan starts on its own
                                 (MainWindow.xaml.cs: Loaded → RunScanCommand). -->
                            <TextBlock Text="Your first scan starts automatically after you connect:" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,4"
                                       Text="1.  DirHealth reads your Active Directory read-only via LDAP — nothing is changed. Run Scan (or F5) repeats it." />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,4"
                                       Text="2.  Findings appear here, most severe first. Open one to see the affected objects, the risk and how to fix it." />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="3.  Add exceptions for accepted risks and export reports (buttons bottom-left)." />
                        </StackPanel>
                    </Border>

                    <!-- No-findings after scan -->
                    <TextBlock Margin="0,24,0,0" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="✓ No findings — your AD looks healthy!">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding FindingsCount}" Value="0" />
                                            <Condition Binding="{Binding IsFirstRun}"    Value="False" />
                                            <!-- Q21: zero findings because checks failed is not "healthy" -->
                                            <Condition Binding="{Binding HasFailedChecks}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <!-- Score trend chart -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,12"
                    Visibility="{Binding ScoreHistory.Count, Converter={StaticResource NonZeroToVisibility}, Mode=OneWay}">
                <StackPanel>
                    <TextBlock Text="Score Trend" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <Canvas x:Name="TrendChart" Height="72"
                            SizeChanged="TrendChart_SizeChanged" />
                </StackPanel>
            </Border>
            <!-- Changes since last scan -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12"
                    Visibility="{Binding HasDiff, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Changes since last scan" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding LastDiff.ScoreDelta, StringFormat='Score: +{0} ▲'}" />
                                    <Setter Property="Foreground" Value="#4ADE80"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastDiff.ScoreDelta, Converter={StaticResource IsNegativeConverter}}" Value="True">
                                            <Setter Property="Text" Value="{Binding LastDiff.ScoreDelta, StringFormat='Score: {0} ▼'}"/>
                                            <Setter Property="Foreground" Value="#E05555"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LastDiff.ScoreDelta}" Value="0">
                                            <Setter Property="Text" Value="Score: unchanged"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        </DataTrigger>
                                        <!-- ADR 0002: no delta across a formula change -->
                                        <DataTrigger Binding="{Binding LastDiff.ScoreComparable}" Value="False">
                                            <Setter Property="Text" Value="Score: new formula — not comparable"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Resolved findings -->
                    <ItemsControl ItemsSource="{Binding LastDiff.ResolvedFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="11" Foreground="#4ADE80" Margin="0,1"
                                           Text="{Binding Title, StringFormat='✓ Resolved: {0}'}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- New findings -->
                    <ItemsControl ItemsSource="{Binding LastDiff.NewFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="11" Foreground="#E05555" Margin="0,1"
                                           Text="{Binding Title, StringFormat='⚠ New: {0}'}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Changed counts -->
                    <ItemsControl ItemsSource="{Binding LastDiff.ChangedFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="11" Margin="0,1">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#4ADE80"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Delta, Converter={StaticResource IsNegativeConverter}}" Value="False">
                                                    <Setter Property="Foreground" Value="#E05555"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding Finding.Title, Mode=OneWay}"/>
                                    <Run Text="{Binding Delta, StringFormat=': {0:+#;-#;0}', Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
