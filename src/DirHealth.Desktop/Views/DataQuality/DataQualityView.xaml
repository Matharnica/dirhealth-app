<UserControl x:Class="DirHealth.Desktop.Views.DataQuality.DataQualityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left panel -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,20,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Data Quality" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="0" Text="User master-data completeness" FontSize="11"
                           VerticalAlignment="Bottom"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />

                <StackPanel Grid.Row="1">
                    <Border Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="USERS ANALYSED" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding TotalUsers}" FontSize="24" FontWeight="Black"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}"
                            Content="↻  Refresh" Command="{Binding LoadCommand}"
                            AutomationProperties.Name="Refresh data quality report"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                    <Button Style="{StaticResource SecondaryButton}"
                            Content="⤓  Export CSV" Command="{Binding ExportCsvCommand}"
                            AutomationProperties.Name="Export data quality report to CSV"
                            HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                    <ProgressBar IsIndeterminate="True" Height="2"
                                 Background="Transparent" Foreground="{StaticResource AccentBrush}"
                                 BorderThickness="0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right: completeness bars -->
        <Grid Grid.Column="1" Margin="24,20,24,20">
            <!-- Not-loaded placeholder -->
            <TextBlock Text="Click Refresh to measure data completeness."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibility}}" />

            <!-- Error state -->
            <TextBlock FontSize="13" TextWrapping="Wrap" MaxWidth="420"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#FCA5A5"
                       Text="{Binding ErrorMessage, StringFormat='⚠ Could not load data quality: {0}'}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

            <!-- Empty state -->
            <TextBlock Text="No user accounts found."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Attributes}"
                          AutomationProperties.Name="Attribute completeness"
                          Visibility="{Binding TotalUsers, Converter={StaticResource NonZeroToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding AttributeName}"
                                               FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding CountLabel}"
                                               FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding PercentLabel}"
                                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Grid>
                                <ProgressBar Grid.Row="1" Height="10" Minimum="0" Maximum="100"
                                             Value="{Binding Percent, Mode=OneWay}"
                                             Background="{DynamicResource BackgroundBrush}"
                                             Foreground="{StaticResource AccentBrush}"
                                             BorderThickness="0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
